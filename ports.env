# --- Ports: same folder as start.bat (this file overrides backend/.env for these keys) ---
# BACKEND_PORT=0  → first free port from 8000 upward (run_dev/run_prod write .backend-port for Vite)
# BACKEND_PORT=8010 → fixed port. Optional override: VITE_PROXY_TARGET=http://127.0.0.1:8010 in frontend/.env
BACKEND_PORT=0

# Optional: frontend dev server port (read by Vite if you add to frontend/.env as VITE_DEV_PORT)
# FRONTEND_PORT=5173
