# Optional: call the API directly (no Vite /api proxy). The host:port must match the running
# backend. With BACKEND_PORT=0 in ../ports.env the API is often NOT on 8000 — check the
# backend window or repo-root .backend-port. For local dev, prefer leaving this unset.
# VITE_API_URL=http://127.0.0.1:8000

# Dev server port (optional; default 5173)
# VITE_DEV_PORT=5173

# When VITE_API_URL is unset, Vite proxies /api to:
#   1) VITE_PROXY_TARGET if set, else
#   2) port from repo-root .backend-port (written when backend starts), else
#   3) http://127.0.0.1:8000
# Start backend before npm run dev so .backend-port matches (see ../ports.env BACKEND_PORT=0).
# VITE_PROXY_TARGET=http://127.0.0.1:8010
