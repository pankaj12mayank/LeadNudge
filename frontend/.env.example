# Direct API (no /api prefix). Use when frontend and backend run on different origins.
VITE_API_URL=http://localhost:8000

# Dev server port (optional; default 5173)
# VITE_DEV_PORT=5173

# When VITE_API_URL is unset, Vite proxies /api → this target (optional)
# VITE_PROXY_TARGET=http://127.0.0.1:8000
