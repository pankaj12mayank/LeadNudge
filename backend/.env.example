DATABASE_URL=sqlite:///./app.db
SECRET_KEY=change-me-in-production
# local = Ollama only | api = allow OpenAI when workspace AI mode + key
MODE=local
OLLAMA_URL=http://127.0.0.1:11434
# Must match a name from `ollama list` (add :tag if needed, e.g. llama3.2:latest)
OLLAMA_MODEL=llama3.2:latest
# Optional global OpenAI key (workspace key overrides when set)
OPENAI_API_KEY=
# Server port (overrides repo-root ports.env if this file is loaded second)
# Use 0 = first free from 8000 (see ports.env next to start.bat)
PORT=8000
# Optional: extra CORS origins, comma-separated (5173 defaults included)
# CORS_ORIGINS=http://localhost:3000
# Bootstrap admin (created once if no admin with this email exists)
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=changeme
